# Servidor de TESTE local (so este PC). Copie para teste-servidor/dados/server.properties.
level-name=world
level-type=minecraft\:normal
generate-structures=true
online-mode=true
server-port=25565
view-distance=6
simulation-distance=4
spawn-protection=0
max-players=4
motd=daRosa - teste local
enable-rcon=true
rcon.port=25575
# a mesma senha que gerador/rcon.py usa (o RCON so escuta em 127.0.0.1)
rcon.password=teste-local-minicraft
broadcast-rcon-to-ops=false
